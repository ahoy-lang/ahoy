program demo

? A game on the ahoy engine: nodes come from a scene file, scripts are named
? functions attached to them, and the level text arrives on the job pool.
?
?   ./ahoy-bin -f demo/main.ahoy -r -D BACKEND_RAYLIB
?   ./ahoy-bin -f demo/main.ahoy -r -D BACKEND_RAYLIB -D DEMO_SHOT   ? 90 frames
?
? Controls: arrows or WASD move the orb, R pings the gem.

import "/home/lee/Documents/ahoy-lang/ahoy/repos/raylib/src/raylib.h"
import "../engine"

? the world the camera scrolls over (the window is 720x480)
WORLD_W:: float = 1500.0
WORLD_H:: float = 480.0

? --- scripts ----------------------------------------------------------------

@ player_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
	n: nodes[id]

	dx: 0.0
	dy: 0.0
	if r.key_down|KEY_LEFT| or r.key_down|KEY_A| then
		dx = dx - 1.0
	$
	if r.key_down|KEY_RIGHT| or r.key_down|KEY_D| then
		dx = dx + 1.0
	$
	if r.key_down|KEY_UP| or r.key_down|KEY_W| then
		dy = dy - 1.0
	$
	if r.key_down|KEY_DOWN| or r.key_down|KEY_S| then
		dy = dy + 1.0
	$

	speed: 320.0
	n.x = n.x + dx * speed * dt
	n.y = n.y + dy * speed * dt

	if dx is not 0.0 then
		n.rot = dx * 12.0
	$
	if dx is 0.0 then
		n.rot = 0.0
	$

	? AABB against the props group: touching a crate turns the orb red. The
	? hit test and the group scan are engine helpers, so a script stays short.
	hit: node_overlaps_group|nodes, id, "props"|
	if hit >= 0 then
		n.tint = TINT_RED
	$
	if hit < 0 then
		n.tint = TINT_WHITE
	$

	? keep it inside the world (the camera scrolls over it)
	w: WORLD_W
	h: WORLD_H
	if n.x < 20.0 then
		n.x = 20.0
	$
	if n.x > w - 20.0 then
		n.x = w - 20.0
	$
	if n.y < 20.0 then
		n.y = 20.0
	$
	if n.y > h - 20.0 then
		n.y = h - 20.0
	$

	nodes[id] = n
$

@ gem_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
	n: nodes[id]
	n.rot = n.rot + 90.0 * dt
	n.timer = n.timer + dt

	? bob around the home height stored in the node's data slot
	phase: int(n.timer * 120.0) % 120
	offset: float(phase)
	if offset > 60.0 then
		offset = 120.0 - offset
	$
	n.y = float(n.data) + offset / 6.0
	nodes[id] = n
$

@ hud_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
	n: nodes[id]
	? f-strings use a static buffer, so build the label fresh every frame;
	? an expression in {..} must be a plain name, hence the locals
	ms: r.frame_time||
	fps: int(1.0 / dt)
	ms_total: int(ms * 1000.0)
	crates: group_find|nodes, "props"|
	count: crates.length
	n.text = f"fps {fps}   {ms_total} ms   props {count}"
	nodes[id] = n
$

@ hints_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
	n: nodes[id]
	if r.key_pressed|KEY_R| then
		n.timer = 1.0
	$
	nodes[id] = n
$

@ crate_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
	n: nodes[id]
	n.timer = n.timer + dt
	if n.timer > 2.0 then
		n.timer = 0.0
		? cycle the crates' tint so the group is visibly alive
		if n.tint is TINT_WHITE then
			n.tint = TINT_GREEN
		$
		if n.tint is TINT_GREEN then
			n.tint = TINT_YELLOW
		$
		if n.tint is TINT_YELLOW then
			n.tint = TINT_WHITE
		$
	$
	nodes[id] = n
$

? --- signals ----------------------------------------------------------------

? A handler gets the scene and the assets, so it can use the engine API like
? any other game code. main owns the button check and emits; the handler spawns.
@ on_spawn |nodes:array[Node], a:Assets, payload:int| void:
	slot: nodes.length % 8
	x: 120.0 + float(slot) * 44.0
	crate_tex: assets_texture_index|a.tex_names, "crate"|
	c: node_sprite|"crate_extra", crate_tex|
	c.x = x
	c.y = 300.0
	c.layer = 2
	c.groups = "props"
	c.tint = TINT_BLUE
	c.process = &crate_process
	node_add|nodes, c|
$

@ camera_follow |nodes:array[Node], r:Renderer, camera:Camera2D, dt:float| Camera2D:
	player_id: node_find|nodes, "player"|
	view: Camera2D = camera
	if player_id < 0 then
		return view
	$
	p: nodes[player_id]
	sw: r.screen_w||
	sh: r.screen_h||
	scale: float(sw) / 720.0
	? aim the eye at the player, then clamp to the world
	eye_x: p.x
	eye_y: p.y
	half_w: float(sw) / 2.0 / scale
	half_h: float(sh) / 2.0 / scale
	if eye_x < half_w then
		eye_x = half_w
	$
	if eye_x > WORLD_W - half_w then
		eye_x = WORLD_W - half_w
	$
	if eye_y < half_h then
		eye_y = half_h
	$
	if eye_y > WORLD_H - half_h then
		eye_y = WORLD_H - half_h
	$
	view.target = Vector2{x: eye_x, y: eye_y}
	view.offset = Vector2{x: float(sw) / 2.0, y: float(sh) / 2.0}
	view.zoom = scale
	return view
$

? --- scene wiring -----------------------------------------------------------

? A scene file names nodes; the game decides what they do. Scripts are just
? function values, so attaching one is a field assignment.
@ attach_scripts |nodes:array[Node]| void:
	player_id: node_find|nodes, "player"|
	node_set_script|nodes, player_id, &player_process|

	gem_id: node_find|nodes, "gem"|
	node_set_script|nodes, gem_id, &gem_process|
	gem: node_get|nodes, gem_id|
	node_set_data|nodes, gem_id, int(gem.y)|

	hud_id: node_find|nodes, "hud"|
	node_set_script|nodes, hud_id, &hud_process|

	hint_id: node_find|nodes, "hint"|
	node_set_script|nodes, hint_id, &hints_process|

	? the flame is a 6-frame sprite sheet: anim_process advances it
	flame_id: node_find|nodes, "flame"|
	node_set_script|nodes, flame_id, &anim_process|

	? every crate in the group gets the same script
	crates: array = group_find|nodes, "props"|
	loop k:0 to crates.length do
		crate_id: crates[k]
		node_set_script|nodes, crate_id, &crate_process|
		node_set_tint|nodes, crate_id, TINT_WHITE|
	$
$

@ show_level_text |nodes:array[Node], body:string| void:
	id: node_find|nodes, "level"|
	if id < 0 then
		return
	$
	node_set_text|nodes, id, body|
$

? --- main -------------------------------------------------------------------

@ main ||:
	nodes: array[Node] = []
	r: Renderer = make_null_renderer||
	quit: [0]

	when BACKEND_RAYLIB then
		r = make_raylib_renderer||
		engine_open|r, 720, 480, "ahoy engine demo", 60|
	$

	a: Assets = assets_new||
	signals: array[Signal] = signals_new||
	signal_connect|signals, "spawn", &on_spawn|
	? textures load on the main thread: uploading needs the GL context
	assets_load_texture|r, a.textures, a.tex_names, "player", "demo/assets/player.png"|
	assets_load_texture|r, a.textures, a.tex_names, "gem", "demo/assets/gem.png"|
	assets_load_texture|r, a.textures, a.tex_names, "crate", "demo/assets/crate.png"|
	assets_load_texture|r, a.textures, a.tex_names, "flame", "demo/assets/flame.png"|

	? One pool per kind of asset: drain() hands out every finished job of the
	? pool, not just the ones from a given pending list, so two lists sharing a
	? pool would receive each other's results. Two pools keep two workers busy.
	scene_pool: pool = jobs|1|
	text_pool: pool = jobs|1|
	pending_scene: []
	pending_level: []
	scene_texts: array[string] = []
	level_texts: array[string] = []
	assets_request_text|scene_pool, pending_scene, "demo/assets/level.scene"|
	assets_request_text|text_pool, pending_level, "demo/assets/level1.txt"|

	camera: Camera2D{offset: Vector2{x: 360.0, y: 240.0}, target: Vector2{x: 360.0, y: 240.0}, rotation: 0.0, zoom: 1.0}

	spawned: 0
	level_shown: 0
	frames: 0

	loop till not (r.should_close|| or quit[0] is 1) do
		frames = frames + 1

		assets_drain_text|scene_pool, pending_scene, scene_texts|
		assets_drain_text|text_pool, pending_level, level_texts|

		if spawned is 0 and scene_texts.length > 0 then
			body: scene_texts[0]
			added: scene_load|nodes, body, a|
			attach_scripts|nodes|
			spawned = added
		$
		if level_shown is 0 and level_texts.length > 0 then
			show_level_text|nodes, level_texts[0]
			level_shown = 1
		$

		camera = camera_follow|nodes, r, camera, 0.016|

		? immediate-mode UI: the game checks its own button each frame
		btn: node_find|nodes, "btn"|
		if btn >= 0 then
			clicked: ui_button|nodes, btn, r|
			if clicked then
				fired: signal_emit|signals, "spawn", nodes, a, 1|
			$
		$

		engine_frame_camera|nodes, r, camera, a|

		when DEMO_SHOT then
			? no mouse in a headless run: drive the button's signal directly so
			? the screenshot covers the spawn path too
			if frames is 45 then
				fired: signal_emit|signals, "spawn", nodes, a, 1|
			$
			if frames is 60 then
				take_screenshot|"demo/shot.png"|
			$
			if frames is 90 then
				quit[0] = 1
			$
		$
	$

	scene_pool.stop||
	text_pool.stop||
	engine_close|r|

	print|"frames: ", frames|
	print|"nodes spawned from the scene file: ", spawned|
$
