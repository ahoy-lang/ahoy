program ahoy_engine

? ---------------------------------------------------------------------------
? Nodes and the scene.
?
? The scene is a flat array[Node]; its index is the node's id. Draw order is
? list order, and every node carries a script triplet (ready/process/draw) as
? function values, which is Ahoy's equivalent of a script attached to a node:
?
?     @ spin |nodes:array[Node], id:int, dt:float, r:Renderer| void:
?         n: nodes[id]
?         n.rot = n.rot + 90.0 * dt
?         nodes[id] = n          ? arrays hold structs by value: write it back
?     $
?
? Nodes are copied when read out of the array, so a script mutates its node by
? writing the copy back to nodes[id]. Arrays and dicts inside a Node field share
? their storage, so those propagate without the write-back.
?
? A freed node becomes a tombstone (KIND_DEAD): ids stay stable, which keeps
? other nodes' parent/child references valid. scene_compact() is the opt-in
? version that really removes them and therefore renumbers everything.
? ---------------------------------------------------------------------------

enum:int NodeKind:
	0 plain
	1 sprite
	2 label
	3 rect
	4 dead
	5 cube
	6 sphere
	7 node3d
	8 mesh
$

struct Node:
	id: int
	kind: int
	name: string
	parent: int
	? transform (screen space for 2D; x/y/z for 3D backends)
	x: float
	y: float
	z: float
	rot: float
	scale: float
	w: float
	h: float
	d: float
	? presentation
	visible: bool
	layer: int
	groups: string
	tint: int
	texture: int
	model: int
	text: string
	font_size: int
	? script state slots: per-node values a script can use without a dict
	vx: float
	vy: float
	hp: float
	timer: float
	data: int
	? script
	ready: fn(array[Node], int) -> void
	process: fn(array[Node], int, float, Renderer) -> void
	draw: fn(array[Node], int, Renderer) -> void
$

? default script triplet: a node that does nothing --------------------------

@ script_none_ready |nodes:array[Node], id:int| void:
$
@ script_none_process |nodes:array[Node], id:int, dt:float, r:Renderer| void:
$
@ script_none_draw |nodes:array[Node], id:int, r:Renderer| void:
$

? node construction ---------------------------------------------------------

@ node_plain |name:string| Node:
	return node_make|NodeKind.plain, name|
$

@ node_sprite |name:string, texture:int| Node:
	n: Node = node_make|NodeKind.sprite, name|
	n.texture = texture
	return n
$

@ node_label |name:string, text:string| Node:
	n: Node = node_make|NodeKind.label, name|
	n.text = text
	return n
$

@ node_rect |name:string, w:float, h:float| Node:
	n: Node = node_make|NodeKind.rect, name|
	n.w = w
	n.h = h
	return n
$

@ node_cube |name:string, size:float| Node:
	n: Node = node_make|NodeKind.cube, name|
	n.w = size
	n.h = size
	n.d = size
	return n
$

@ node_3d |name:string| Node:
	return node_make|NodeKind.node3d, name|
$

? A loaded mesh/model, drawn spinning around its Y axis by its `rot`.
@ node_mesh |name:string, model:int| Node:
	n: Node = node_make|NodeKind.mesh, name|
	n.model = model
	return n
$

@ node_sphere |name:string, radius:float| Node:
	n: Node = node_make|NodeKind.sphere, name|
	n.w = radius
	return n
$

? One constructor every other one funnels through, so a new Node field only
? needs a default here.
@ node_make |kind:int, name:string| Node:
	return Node{id: -1, kind: kind, name: name, parent: -1, x: 0.0, y: 0.0, z: 0.0, rot: 0.0, scale: 1.0, w: 32.0, h: 32.0, d: 32.0, visible: true, layer: 0, groups: "", tint: TINT_WHITE, texture: -1, text: "", font_size: 20, vx: 0.0, vy: 0.0, hp: 0.0, timer: 0.0, data: 0, ready: &script_none_ready, process: &script_none_process, draw: &script_none_draw}
$

? scene operations ----------------------------------------------------------

@ node_add |nodes:array[Node], n:Node| int:
	idx: n.id
	if idx < 0 then
		idx = nodes.length
	$
	n.id = idx
	nodes.push|n|
	cur: nodes[idx]
	cur.ready|nodes, idx|
	return idx
$

@ node_find |nodes:array[Node], name:string| int:
	loop i:0 to nodes.length do
		cur: nodes[i]
		if cur.name is name then
			return i
		$
	$
	return -1
$

@ node_get |nodes:array[Node], id:int| Node:
	if id < 0 then
		return node_make|NodeKind.plain, "missing"|
	$
	cur: nodes[id]
	return cur
$

@ node_free |nodes:array[Node], id:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.kind = NodeKind.dead
	cur.visible = false
	nodes[id] = cur
$

? -- tree ------------------------------------------------------------------
?
? A node's x/y/z are local to its parent. Scripts move local values; drawing
? and 3D placement use the world values below, which walk the parent chain.
? Parent rotation is not applied to children yet (that needs the trig helpers
? raymath would bring in); position and scale compose.

@ node_add_child |nodes:array[Node], parent_id:int, child_id:int| void:
	if child_id < 0 or child_id >= nodes.length then
		return
	$
	cur: nodes[child_id]
	cur.parent = parent_id
	nodes[child_id] = cur
$

@ node_world_x |nodes:array[Node], id:int| float:
	total: 0.0
	cur_id: id
	guard: 0
	loop till cur_id >= 0 and guard < 64 do
		n: nodes[cur_id]
		total = total + n.x
		cur_id = n.parent
		guard = guard + 1
	$
	return total
$

@ node_world_y |nodes:array[Node], id:int| float:
	total: 0.0
	cur_id: id
	guard: 0
	loop till cur_id >= 0 and guard < 64 do
		n: nodes[cur_id]
		total = total + n.y
		cur_id = n.parent
		guard = guard + 1
	$
	return total
$

@ node_world_z |nodes:array[Node], id:int| float:
	total: 0.0
	cur_id: id
	guard: 0
	loop till cur_id >= 0 and guard < 64 do
		n: nodes[cur_id]
		total = total + n.z
		cur_id = n.parent
		guard = guard + 1
	$
	return total
$

@ node_world_scale |nodes:array[Node], id:int| float:
	total: 1.0
	cur_id: id
	guard: 0
	loop till cur_id >= 0 and guard < 64 do
		n: nodes[cur_id]
		total = total * n.scale
		cur_id = n.parent
		guard = guard + 1
	$
	return total
$

? "a/b/c" walks names down the chain; "c" finds the first node with that name
@ node_find_path |nodes:array[Node], path:string| int:
	segments: array[string] = path.split|"/"|
	parent_id: -1
	loop s:0 to segments.length do
		wanted: segments[s]
		found: -1
		loop i:0 to nodes.length do
			cur: nodes[i]
			if cur.name is wanted then
				if parent_id < 0 then
					found = i
				$
				if parent_id >= 0 and cur.parent is parent_id then
					found = i
				$
			$
		$
		if found < 0 then
			return -1
		$
		parent_id = found
	$
	return parent_id
$

? -- groups -----------------------------------------------------------------

@ node_in_group |nodes:array[Node], id:int, group:string| bool:
	if id < 0 or id >= nodes.length then
		return false
	$
	cur: nodes[id]
	return cur.groups.contains|group|
$

@ group_find |nodes:array[Node], group:string| array:
	ids: []
	loop i:0 to nodes.length do
		cur: nodes[i]
		if cur.visible and cur.kind is not NodeKind.dead and cur.groups.contains|group| then
			ids.push|i|
		$
	$
	return ids
$

? Runs the process scripts of one group, for turning a whole wave of entities
? on and off without a per-frame scan in game code.
@ group_process |nodes:array[Node], group:string, dt:float, r:Renderer| void:
	ids: array = group_find|nodes, group|
	loop k:0 to ids.length do
		i: ids[k]
		cur: nodes[i]
		cur.process|nodes, i, dt, r|
	$
$

? Drop tombstones and renumber. Node ids change, so scripts must not hold ids
? across this call.
@ scene_compact |nodes:array[Node]| void:
	kept: array[Node] = []
	loop i:0 to nodes.length do
		cur: nodes[i]
		if cur.kind is not NodeKind.dead then
			kept.push|cur|
		$
	$
	? arrays have no clear() in this build; pop until empty so the caller's
	? array (a parameter, shared by pointer) is emptied in place
	? `loop till COND` loops *while* COND holds, so the wait is on `is not 0`
	loop till nodes.length is not 0 do
		nodes.pop||
	$
	loop i:0 to kept.length do
		live: kept[i]
		live.id = i
		nodes.push|live|
	$
$


? setters: the write-back pattern in one place ---------------------------------

@ node_set_pos |nodes:array[Node], id:int, x:float, y:float| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.x = x
	cur.y = y
	nodes[id] = cur
$

@ node_move |nodes:array[Node], id:int, dx:float, dy:float| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.x = cur.x + dx
	cur.y = cur.y + dy
	nodes[id] = cur
$

@ node_set_rot |nodes:array[Node], id:int, rot:float| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.rot = rot
	nodes[id] = cur
$

@ node_set_scale |nodes:array[Node], id:int, scale:float| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.scale = scale
	nodes[id] = cur
$

@ node_set_text |nodes:array[Node], id:int, text:string| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.text = text
	nodes[id] = cur
$

@ node_set_tint |nodes:array[Node], id:int, tint:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.tint = tint
	nodes[id] = cur
$

@ node_set_model |nodes:array[Node], id:int, model:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.model = model
	nodes[id] = cur
$

@ node_set_texture |nodes:array[Node], id:int, texture:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.texture = texture
	nodes[id] = cur
$

@ node_set_data |nodes:array[Node], id:int, value:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.data = value
	nodes[id] = cur
$

@ node_set_groups |nodes:array[Node], id:int, groups:string| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.groups = groups
	nodes[id] = cur
$

@ node_set_layer |nodes:array[Node], id:int, layer:int| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.layer = layer
	nodes[id] = cur
$

@ node_set_visible |nodes:array[Node], id:int, visible:bool| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.visible = visible
	nodes[id] = cur
$

@ node_set_script |nodes:array[Node], id:int, process:fn(array[Node], int, float, Renderer) -> void| void:
	if id < 0 then
		return
	$
	cur: nodes[id]
	cur.process = process
	nodes[id] = cur
$

? the frame ----------------------------------------------------------------

@ scene_process |nodes:array[Node], dt:float, r:Renderer| void:
	loop i:0 to nodes.length do
		cur: nodes[i]
		if cur.visible and cur.kind is not NodeKind.dead then
			cur.process|nodes, i, dt, r|
		$
	$
$

? Draw order is (layer, list position): a stable insertion sort over the node
? indices, so a low layer draws first and same-layer nodes keep list order.
@ build_draw_order |nodes:array[Node]| array[int]:
	order: array[int] = []
	loop i:0 to nodes.length do
		order.push|i|
	$
	loop i:1 to order.length do
		j: i
		moving: true
		loop till moving do
			moving = false
			if j > 0 then
				here: nodes[order[j]]
				below: nodes[order[j - 1]]
				if here.layer < below.layer then
					tmp: order[j]
					order[j] = order[j - 1]
					order[j - 1] = tmp
					j = j - 1
					moving = true
				$
			$
		$
	$
	return order
$

? 2D pass. Kinds sprite, label, rect and plain belong to screen space and also
? serve as the overlay a 3D scene draws on top (see engine_frame_3d).
@ scene_draw_2d |nodes:array[Node], r:Renderer, textures:array[Texture2D]| void:
	order: array[int] = build_draw_order|nodes|
	loop k:0 to order.length do
		i: order[k]
		cur: nodes[i]
		if cur.visible and cur.kind is not NodeKind.dead then
			if cur.kind is NodeKind.sprite then
				draw_sprite_node|nodes, i, r, textures|
			$
			if cur.kind is NodeKind.label then
				draw_label_node|nodes, i, r|
			$
			if cur.kind is NodeKind.rect then
				draw_rect_node|nodes, i, r|
			$
			if cur.kind is NodeKind.plain then
				? a plain node has no shape of its own; its script draws it
				cur.draw|nodes, i, r|
			$
		$
	$
$

? Name kept for callers that only ever draw 2D.
@ scene_draw |nodes:array[Node], r:Renderer, textures:array[Texture2D]| void:
	scene_draw_2d|nodes, r, textures|
$

? 3D pass: world (x, y, z) with y up, between the backend's begin3d/end3d.
@ scene_draw_3d |nodes:array[Node], r:Renderer, camera:Camera3D, models:array[Model]| void:
	order: array[int] = build_draw_order|nodes|
	r.begin3d|camera|
	r.draw_grid|40, 1.0|
	loop k:0 to order.length do
		draw_node_3d|nodes, order[k], r, models|
	$
	r.end3d||
$

@ draw_node_3d |nodes:array[Node], id:int, r:Renderer, models:array[Model]| void:
	if id < 0 or id >= nodes.length then
		return
	$
	cur: nodes[id]
	if not cur.visible or cur.kind is NodeKind.dead then
		return
	$
	wx: node_world_x|nodes, id|
	wy: node_world_y|nodes, id|
	wz: node_world_z|nodes, id|
	ws: node_world_scale|nodes, id|
	pos: Vector3 = Vector3{x: wx, y: wy, z: wz}
	if cur.kind is NodeKind.cube then
		r.draw_cube|pos, cur.w * ws, cur.h * ws, cur.d * ws, cur.tint|
		r.draw_cube_wires|pos, cur.w * ws, cur.h * ws, cur.d * ws, TINT_GREY|
	$
	if cur.kind is NodeKind.sphere then
		radius: cur.w * ws
		r.draw_sphere|pos, radius, cur.tint|
		r.draw_sphere_wires|pos, radius, 8, 8, TINT_GREY|
	$
	if cur.kind is NodeKind.mesh then
		mesh: node_model|models, cur.model|
		valid: r.model_valid|mesh|
		if valid then
			axis: Vector3 = Vector3{x: 0.0, y: 1.0, z: 0.0}
			unit: Vector3 = Vector3{x: ws, y: ws, z: ws}
			r.draw_model_ex|mesh, pos, axis, cur.rot, unit, cur.tint|
		$
	$
	? node3d carries no primitive: its script places whatever it wants
	if cur.kind is NodeKind.node3d then
		cur.draw|nodes, id, r|
	$
$

@ draw_sprite_node |nodes:array[Node], id:int, r:Renderer, textures:array[Texture2D]| void:
	cur: nodes[id]
	tex: node_texture|textures, cur.texture|
	wx: node_world_x|nodes, id|
	wy: node_world_y|nodes, id|
	ws: node_world_scale|nodes, id|
	if tex.id is 0 then
		? no texture: draw a placeholder box so the node is visible
		r.draw_rect|wx - 16.0, wy - 16.0, 32.0, 32.0, cur.tint|
		return
	$
	r.draw_sprite|tex, wx, wy, cur.rot, ws, cur.tint|
$

@ draw_label_node |nodes:array[Node], id:int, r:Renderer| void:
	cur: nodes[id]
	wx: node_world_x|nodes, id|
	wy: node_world_y|nodes, id|
	r.draw_text|cur.text, wx, wy, cur.font_size, cur.tint|
$

@ draw_rect_node |nodes:array[Node], id:int, r:Renderer| void:
	cur: nodes[id]
	wx: node_world_x|nodes, id|
	wy: node_world_y|nodes, id|
	ws: node_world_scale|nodes, id|
	w: cur.w * ws
	h: cur.h * ws
	r.draw_rect|wx, wy, w, h, cur.tint|
$

? texture registry: index -> Texture2D (see assets.ahoy, which fills it) -----

@ node_model |models:array[Model], index:int| Model:
	if index < 0 or index >= models.length then
		return Model{}
	$
	mesh: models[index]
	return mesh
$

@ node_texture |textures:array[Texture2D], index:int| Texture2D:
	if index < 0 or index >= textures.length then
		return Texture2D{id: 0, width: 0, height: 0, mipmaps: 1, format: 0}
	$
	tex: textures[index]
	return tex
$
