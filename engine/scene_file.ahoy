program ahoy_engine

? ---------------------------------------------------------------------------
? Scene files.
?
? A scene is a plain text file, one node per line:
?
?     # comment (also blank lines)
?     sprite player 200 180 player          ? kind name x y texture
?     label  title  24  20  "ahoy engine"   ? quoted text, spaces allowed
?     rect   panel  300 340 220 40          ? kind name x y w h
?     cube   core   0   1   0   1.4         ? kind name x y z size
?     sphere ball   0   2   0   0.9
?     node3d rig    0   0   0               ? scripted 3D node
?     mesh   rock   3   0   0   model=pyramid
?
? Optional key=value tokens after the positionals: layer=N, group=NAME,
? texture=NAME, tint=red|green|blue|yellow|black|grey|white. A label's text is the quoted string:
?
?     label title 24 20 "ahoy engine demo"
?     sprite crate1 120 340 crate layer=1 group=props
?
? Loading is plain parsing, so it runs wherever the text arrives -- including a
? job-pool drain handler, which is how the demo spawns its level without
? blocking the first frame. Scripts are attached by the game afterwards (a
? scene file names nodes, not Ahoy functions).
? ---------------------------------------------------------------------------

? The loader is defensive on purpose: a scene file is data, so a malformed
? line is skipped rather than crashing the game at startup.
@ scene_load |nodes:array[Node], text:string, a:Assets| int:
	lines: array[string] = text.split|"\n"|
	added: 0
	loop i:0 to lines.length do
		added = added + scene_load_line|nodes, lines[i], a|
	$
	return added
$

? One node per line; returns 1 when a node was added, 0 otherwise.
? Positional: kind name x y [size/texture] [z]; then any of layer=N group=NAME
? texture=NAME model=NAME tint=COLOUR. A label's text is the quoted string.
@ scene_load_line |nodes:array[Node], line:string, a:Assets| int:
	body: line.strip||
	if body is "" then
		return 0
	$
	if body.contains|"#"| then
		before_hash: array[string] = body.split|"#"|
		body = before_hash[0]
		body = body.strip||
		if body is "" then
			return 0
		$
	$

	? split keeps empty pieces, so collapse runs of spaces here
	raw: array[string] = body.split|" "|
	parts: array[string] = []
	loop k:0 to raw.length do
		piece: raw[k]
		if piece is not "" then
			parts.push|piece|
		$
	$
	if parts.length < 4 then
		return 0
	$

	layer: 0
	group_list: ""
	tex_name: ""
	tint: TINT_WHITE
	loop k:4 to parts.length do
		kv: array[string] = parts[k].split|"="|
		if kv.length is 2 then
			if kv[0] is "layer" then
				layer = int(kv[1])
			$
			if kv[0] is "group" then
				group_list = kv[1]
			$
			if kv[0] is "texture" then
				tex_name = kv[1]
			$
			if kv[0] is "tint" then
				tint = scene_tint|kv[1]|
			$
		$
	$

	? a quoted tail is a label's text
	quoted: array[string] = body.split|"\""|
	text: ""
	if quoted.length > 1 then
		text = quoted[1]
	$

	kind: parts[0]
	name: parts[1]
	x: float(parts[2])
	y: float(parts[3])

	if kind is not "label" and kind is not "sprite" and kind is not "rect" and kind is not "cube" and kind is not "sphere" and kind is not "node3d" then
		return 0
	$

	n: Node = node_plain|name|
	if kind is "label" then
		n = node_label|name, text|
	$
	if kind is "sprite" then
		wanted: tex_name
		if wanted is "" and parts.length >= 5 then
			wanted = parts[4]
		$
		tex_index: assets_texture_index|a.tex_names, wanted|
		n = node_sprite|name, tex_index|
	$
	if kind is "rect" then
		if parts.length < 6 then
			return 0
		$
		n = node_rect|name, float(parts[4]), float(parts[5])|
	$
	if kind is "cube" then
		if parts.length < 5 then
			return 0
		$
		n = node_cube|name, float(parts[4])|
		if parts.length >= 6 then
			n.z = float(parts[5])
		$
	$
	if kind is "sphere" then
		if parts.length < 5 then
			return 0
		$
		n = node_sphere|name, float(parts[4])|
		if parts.length >= 6 then
			n.z = float(parts[5])
		$
	$
	if kind is "node3d" then
		n = node_3d|name|
		if parts.length >= 5 then
			n.z = float(parts[4])
		$
	$
	if kind is "mesh" then
		wanted_model: tex_name
		if wanted_model is "" and parts.length >= 5 then
			wanted_model = parts[4]
		$
		model_index: assets_model_index|a.model_names, wanted_model|
		n = node_mesh|name, model_index|
		if parts.length >= 5 then
			n.z = float(parts[4])
		$
	$

	n.x = x
	n.y = y
	n.layer = layer
	n.groups = group_list
	n.tint = tint
	node_add|nodes, n|
	return 1
$

? Colour names for scene files: tint=red reads better than a packed integer.
@ scene_tint |name:string| int:
	if name is "red" then
		return TINT_RED
	$
	if name is "green" then
		return TINT_GREEN
	$
	if name is "blue" then
		return TINT_BLUE
	$
	if name is "yellow" then
		return TINT_YELLOW
	$
	if name is "black" then
		return TINT_BLACK
	$
	if name is "grey" then
		return TINT_GREY
	$
	return TINT_WHITE
$
