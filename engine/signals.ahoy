program ahoy_engine

? ---------------------------------------------------------------------------
? Signals: a name plus handlers, in the same style as everything else here --
? an array declared in main and passed to whoever connects or emits.
?
? Handlers live in a struct rather than directly in the array because a
? function value read straight out of an untyped array is not callable
? (`f: handlers[i]` then `f|payload|` fails the checker); a typed array of
? Signal structs is.
?
?     signals: array[Signal] = signals_new||
?     signal_connect|signals, "spawn", &on_spawn|
?     fired: signal_emit|signals, "spawn", nodes, a, 3|
?
? A handler receives the scene, the asset bundle and one int payload. It gets
? the scene because a handler that cannot reach it can do nothing useful (a
? lambda body cannot call a helper -- calls in lambdas do not parse -- so
? closures are not an option here), and it gets the payload for the rest.
? ---------------------------------------------------------------------------

struct Signal:
	name: string
	handler: fn(array[Node], Assets, int)->void
$

@ signals_new || array[Signal]:
	empty: array[Signal] = []
	return empty
$

@ signal_connect |signals:array[Signal], name:string, handler:fn(array[Node], Assets, int)->void| void:
	signals.push|Signal{name: name, handler: handler}|
$

@ signal_disconnect |signals:array[Signal], name:string| void:
	kept: array[Signal] = []
	loop i:0 to signals.length do
		s: signals[i]
		if s.name is not name then
			kept.push|s|
		$
	$
	loop till not signals.length is not 0 do
		signals.pop||
	$
	loop i:0 to kept.length do
		restored: kept[i]
		signals.push|restored|
	$
$

? Calls every handler for a name; returns how many ran.
@ signal_emit |signals:array[Signal], name:string, nodes:array[Node], a:Assets, payload:int| int:
	fired: 0
	loop i:0 to signals.length do
		s: signals[i]
		if s.name is name then
			s.handler|nodes, a, payload|
			fired = fired + 1
		$
	$
	return fired
$

@ signal_count |signals:array[Signal], name:string| int:
	total: 0
	loop i:0 to signals.length do
		s: signals[i]
		if s.name is name then
			total = total + 1
		$
	$
	return total
$
