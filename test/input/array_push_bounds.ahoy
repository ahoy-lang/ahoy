program array_push_bounds

? Pushing onto an array must keep the bounds check from firing on reads
? that the push made valid. Statement-level method calls were invisible to
? the length tracking, so every literal read below was called out of bounds.

@ main ||:
	expected: []

	xs: array[int] = []
	xs.push|4|
	xs.push|9|
	print|xs.length, xs[0], xs[1]|
	expected.push|"2 4 9"|

	xs.pop||
	print|xs.length, xs[0]|
	expected.push|"1 4"|

	names: array[string] = []
	names.push|"ada"|
	names.push|"bob"|
	print|names[1]|
	expected.push|"bob"|

	? mutations inside a block count too (the length becomes unknown to the
	? bounds check, which is the point - it runs a variable number of times)
	loop i:0 to 2 do
		xs.push|i + 10|
	$
	print|xs.length, xs[2]|
	expected.push|"3 11"|

	print|expected|
$
