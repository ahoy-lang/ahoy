program field_store_retain

? Struct fields outlive the store statement: a loop-local string kept in
? a field must be duplicated, or the field dangles at scope exit. The
? duplicate is never freed (struct teardown gap, documented) — sound.

struct Card:
	text: string
$

@ main ||:
	expected: []
	c: Card{text: ""}
	loop i:0 to 3 do
		s: "v" + "w"
		c.text = s
	$
	print|c.text|
	expected.push|"vw"|
	print|expected|
$
