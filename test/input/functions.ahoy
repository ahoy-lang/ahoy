? Functions test
x: 5
y: 10
z: x + y
print|z| ? should print: 15
expected.push|"15"|



@ multiple |name:string,phone:int| string, int:
	return name, phone
$

name, phone: multiple|"Alice", 1234567890|
print|name,phone|
expected.push|"Alice 1234567890"|


? multiple infer
@ multiple_infer |name:string,phone| infer:
	return name, phone
$

name1, phone2 : multiple_infer|"Alice", 1234567890|
print|name1,phone2|
expected.push|"Alice 1234567890"|

? test_generics infer
@ test_generics |name,phone,location:generic,postcode| infer:
	return name, phone,location,postcode
$

name, phone,location,postcode : test_generics|"Alice", 1234567890,"madrid",9220|
print|name.type,phone.type,location.type,postcode.type|
expected.push|"string int string int"|;


? test_defer in function
@ test_defer || void:
	print|"no-defer1"|
	defer print|"defer1"|
	defer print|"defer2"|
	defer print|"defer3"|
	print|"no-defer2"|
$
test_defer||

expected.push|"no-defer1"|
expected.push|"no-defer2"|
expected.push|"defer3"|
expected.push|"defer2"|
expected.push|"defer1"|



@ return_typed_dict_and_array || array[int],dict<string,int>:
  my_nums:array[int] = [1, 2, 3]
  my_dictionary:dict<string,int> = <"a": 1, "b": 2>
  print|"Data processed"|
  print|my_nums|
  return my_nums, my_dictionary
$

my_nums, my_dictionary : return_typed_dict_and_array||
print|my_nums,my_dictionary|
expected.push|"Data processed"|
expected.push|"[1, 2, 3]"|
expected.push|"[1, 2, 3] {\"a\": 1, \"b\": 2}"|

@ test_dictionary||dict<string,int>,dict<string,int>:
	test_dict :dict<string,int> = <"a": 1, "b": 2>;
	return test_dict,test_dict
$
? Test typed parameters
@ test_typed_params |arr:array[string], count:int| void:
	new_dict,new_dict2: test_dictionary||;
$
	? print|new_dict,new_dict2|
?   print|arr[0]|
?   print|arr[1]|
?   print|count|
? $

array_test:array[string]= ["hello", "world"]
test_typed_params|array_test, 42|
? print|array_test|
expected.push|"hello"|
expected.push|"world"|
expected.push|42|

