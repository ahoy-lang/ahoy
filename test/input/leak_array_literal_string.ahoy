program leak_array_literal_string

? Literal-ownership discipline: string arrays own every slot by
? construction (non-ephemeral elements are duplicated at creation, fresh
? ephemeral values transfer). Previously literal f-string elements were
? duplicated again without freeing the original, leaking two per iteration.

@ main ||:
	expected: []

	total: 0
	loop i:0 to 500 do
		a: array[string] = [f"a-{i}", f"b-{i}"]
		total = total + a.length
	$
	print|total|
	expected.push|"1000"|

	print|expected|
$
