program leak_user_call_return

? Caller-side contract: every user-function string return is Owned (the
? callee returns strdup), so the caller must free it at scope exit.
? Previously declarations from user calls were never tracked and leaked.

@ make || string:
	return "x" + "y"
$

@ main ||:
	expected: []

	s: make()
	print(s)
	expected.push("xy")

	total: 0
	loop i:0 to 200 do
		r: make()
		total = total + r.byte_len()
	$
	print(total)
	expected.push("400")

	print(expected)
$
