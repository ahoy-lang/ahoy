program methods_test

? Go-style receiver methods (@ (recv T) name) and associated functions
? (@ T.name). Methods lower to Type_method with the receiver prepended.

struct Point:
	x: float
	y: float
$

@ Point.make |x:float, y:float| Point:
	return Point{x: x, y: y}
$

@ (p Point) move |dx:float, dy:float| Point:
	p.x = p.x + dx
	p.y = p.y + dy
	return p
$

@ (p Point) sum || float:
	return p.x + p.y
$

struct Box:
	w: float
	h: float
$

? Scene-style handle methods: the array receiver mutates in place.
@ (s array[Box]) total_area || float:
	total: 0.0
	loop b in s do
		total = total + b.w * b.h
	$
	return total
$

@ (s array[Box]) count || int:
	return s.length
$

@ main ||:
	expected: []

	p: Point.make|1.0, 2.0|
	print|p.x|
	expected.push|"1"|

	q: p.move|3.0, 4.0|
	print|q.x|
	expected.push|"4"|
	print|q.y|
	expected.push|"6"|

	s: q.sum||
	print|s|
	expected.push|"10"|

	boxes:array[Box]= [Box{w: 2.0, h: 3.0}, Box{w: 4.0, h: 5.0}]
	n: boxes.count||
	print|n|
	expected.push|"2"|

	area: boxes.total_area||
	print|area|
	expected.push|"26"|

	print|expected|
$
