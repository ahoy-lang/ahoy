program struct_array_field

? An array field of a struct must take pushes of struct values: the
? engine's asset registries are exactly that shape (a struct holding an
? array of structs), and the push used to be generated as a bare
? pointer cast that did not compile. The push copies the value and the
? read-back dereferences it, so the round trip has to be exact.

struct Thing:
	name: string
	value: int = 0
$

struct Holder:
	label: string
	items: array[Thing] = []
	nums: array[int] = []
$

@ fill |h:Holder| void:
	t: Thing = Thing{name: "ada", value: 7}
	h.items.push|t|
	h.nums.push|42|
$

@ main ||:
	expected: []

	h: Holder = Holder{label: "box", items: []}
	fill|h|
	print|h.items.length|
	expected.push|"1"|

	got: Thing = h.items[0]
	print|got.name, got.value|
	expected.push|"ada 7"|

	? a second push keeps the order
	t2: Thing = Thing{name: "bob", value: 9}
	h.items.push|t2|
	print|h.items.length|
	expected.push|"2"|

	g2: Thing = h.items[1]
	print|g2.name, g2.value|
	expected.push|"bob 9"|

	? the field is shared with a copy of the struct (the array is a
	? pointer), so a copy sees the same items
	h2: Holder = h
	print|h2.items.length|
	expected.push|"2"|

	print|h.nums[0]|
	expected.push|"42"|

	print|expected|
$
