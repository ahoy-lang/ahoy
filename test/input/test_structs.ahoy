expected.push|"player_info{MAX_HAND:5, deck_count:15, selected_idx:-1, dragging:false, hover_row:-1, hover_col:-1, placed_count:0, hand_size:7}"|;
print|player_information3|
expected.push|"player_info{MAX_HAND:5, deck_count:20, selected_idx:-1, dragging:false, hover_row:-1, hover_col:-1, placed_count:0, hand_size:7}"|;

