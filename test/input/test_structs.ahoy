print|new_card|
expected.push|"Card{id:3, row:1, col:0, rotation:45, owner:0, image_idx:0, health:0, attack:5}"|

assassin_card: Assassin{}
print|assassin_card|
expected.push|"Assassin{row:0, col:0, rotation:0, owner:0, id:1, image_idx:0, health:2, attack:2, image_path:\"my_image.png\", can_move:true}"|

