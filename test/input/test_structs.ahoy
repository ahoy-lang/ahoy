struct Card:
	id:int
	row:int
	col:int
	rotation: int
	owner:int
	image_idx:int
	health:int
	attack:int
	type Assassin:
		1 id:int
		image_idx:int
		2 health:int
		2 attack:int
		"my_image.png" image_path:string
		true can_move:bool
$

camera_zoom:float = 1.5
player_information : player_info{deck_count:15, MAX_HAND:5}
player_information2 : player_info{deck_count:15, MAX_HAND:5}
player_information3 : player_info{deck_count:20, MAX_HAND:5}
? player_information.MAX_HAND : 10 ? COMMENTED: because MAX_HAND is not mutable(screaming snake), this would be a linting error.
player_information.deck_count : 10 ? should change on this instance object only
player_info.#hand_size : 7 ? this should change player_information and player_information2 hand_size because #hand_size is static (#) accross instances
print|player_information|
expected.push|"player_info{MAX_HAND:5, deck_count:10, selected_idx:-1, dragging:false, hover_row:-1, hover_col:-1, placed_count:0, hand_size:7}"|;
